# ==============================================================================
# Caddyfile - FrankenPHP & Caddy Web Server Configuration for Laravel Octane
#
# Configures the FrankenPHP worker mode, Mercure SSE hub injection,
# request logging with authorization token redaction, and PHP routing.
# ==============================================================================

{
	{$CADDY_GLOBAL_OPTIONS}

	# Administrative API endpoint
	admin {$CADDY_SERVER_ADMIN_HOST:localhost}:{$CADDY_SERVER_ADMIN_PORT:2019}

	# FrankenPHP worker runtime definition
	frankenphp {
		worker {
			file "{$APP_PUBLIC_PATH}/frankenphp-worker.php"
			{$CADDY_SERVER_WORKER_DIRECTIVE}
			{$CADDY_SERVER_WATCH_DIRECTIVES}
		}
	}
}

{$CADDY_EXTRA_CONFIG}

{$CADDY_SERVER_SERVER_NAME:http://localhost} {
	log {
		level {$CADDY_SERVER_LOG_LEVEL:INFO}

		# Redact the authorization query parameter that can be set by Mercure
		format filter {
			wrap {$CADDY_SERVER_LOGGER:json}
			fields {
				uri query {
					replace authorization REDACTED
				}
			}
		}
	}

	route {
		root * "{$APP_PUBLIC_PATH}"
		encode zstd br gzip

		# Mercure Hub is dynamically injected here by Octane config
		{$CADDY_SERVER_EXTRA_DIRECTIVES}

		php_server {
			index frankenphp-worker.php
			try_files {path} frankenphp-worker.php
			resolve_root_symlink
		}
	}
}
