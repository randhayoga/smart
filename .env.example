# ==============================================================================
# SMART - Environment Configuration Template
# ==============================================================================

APP_NAME=SMART
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://smart.example.com

# Server & Ingress Configuration (FrankenPHP / Caddy Direct TLS)
# When OCTANE_HTTPS=true, FrankenPHP automatically requests and renews Let's Encrypt / ZeroSSL TLS certificates
SERVER_NAME=smart.example.com
OCTANE_HTTPS=true
OCTANE_WORKERS=auto
OCTANE_MAX_REQUESTS=1000

APP_LOCALE=id
APP_TIMEZONE=Asia/Jakarta
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logging Configuration (stdout/stderr is recommended for Docker)
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Configuration - SMART Primary Database (MSSQL)
MSSQL_SA_PASSWORD=
DB_CONNECTION=SMART
DB_SMART_HOST=db
DB_SMART_PORT=1433
DB_SMART_DATABASE=smart
DB_SMART_USERNAME=smart_user
DB_SMART_PASSWORD=
DB_SMART_TRUST_SERVER_CERTIFICATE=true

# External Database Connections (SQL Server)
# Point to either the internal db container or dedicated production database hosts
DB_READY_HOST=db
DB_READY_PORT=1433
DB_READY_DATABASE=new_portal
DB_READY_USERNAME=smart_user
DB_READY_PASSWORD=
DB_READY_TRUST_SERVER_CERTIFICATE=true

DB_USER_HRIS_HOST=db
DB_USER_HRIS_PORT=1433
DB_USER_HRIS_DATABASE=USER_HRIS
DB_USER_HRIS_USERNAME=smart_user
DB_USER_HRIS_PASSWORD=
DB_USER_HRIS_TRUST_SERVER_CERTIFICATE=true

DB_HOST_REPORTAL=db
DB_PORT_REPORTAL=1433
DB_DATABASE_REPORTAL=RE_PORTALDB
DB_USERNAME_REPORTAL=smart_user
DB_PASSWORD_REPORTAL=
DB_REPORTAL_TRUST_SERVER_CERTIFICATE=true

# Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Queue & Background Processing
QUEUE_CONNECTION=database

# Broadcast & Cache Configuration
BROADCAST_CONNECTION=mercure
CACHE_STORE=database
FILESYSTEM_DISK=local

# Mail Configuration (SMTP)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Mercure Real-time Hub
# MERCURE_URL is the internal dispatch endpoint used by Laravel backend
# MERCURE_PUBLIC_URL is the external URL connected by client web browsers (must use public HTTPS domain)
MERCURE_URL=http://127.0.0.1:80/.well-known/mercure
MERCURE_PUBLIC_URL=https://smart.example.com/.well-known/mercure
MERCURE_JWT_SECRET=