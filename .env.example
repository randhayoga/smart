# ==============================================================================
# SMART - Environment Configuration Template
# ==============================================================================

APP_NAME=SMART
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://smart.example.com

# Server & Ingress Configuration (Host NGINX Reverse Proxy + Laravel Octane)
# In production, host NGINX terminates SSL/TLS (ports 80 & 443) and reverse proxies to 127.0.0.1:8000
OCTANE_PORT=8000
OCTANE_WORKERS=auto
OCTANE_MAX_REQUESTS=1000
OCTANE_HTTPS=false

APP_LOCALE=id
APP_TIMEZONE=Asia/Jakarta
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logging Configuration
# Application logs are securely written to storage/logs/laravel.log (file-only) with restricted permissions to prevent sensitive trace leaks to container stdout
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Configuration - SMART Primary Database (MSSQL)
# In production, set to your dedicated database server IP/hostname
# In local development with Docker, set DB_SMART_HOST=db
MSSQL_SA_PASSWORD=
DB_CONNECTION=SMART
DB_SMART_HOST=127.0.0.1
DB_SMART_PORT=1433
DB_SMART_DATABASE=smart
DB_SMART_USERNAME=smart_user
DB_SMART_PASSWORD=
DB_SMART_TRUST_SERVER_CERTIFICATE=true

# External Database Connections (SQL Server)
# Point to your dedicated production database hosts (or 'db' in local docker dev)
DB_READY_HOST=127.0.0.1
DB_READY_PORT=1433
DB_READY_DATABASE=new_portal
DB_READY_USERNAME=smart_user
DB_READY_PASSWORD=
DB_READY_TRUST_SERVER_CERTIFICATE=true

DB_USER_HRIS_HOST=127.0.0.1
DB_USER_HRIS_PORT=1433
DB_USER_HRIS_DATABASE=USER_HRIS
DB_USER_HRIS_USERNAME=smart_user
DB_USER_HRIS_PASSWORD=
DB_USER_HRIS_TRUST_SERVER_CERTIFICATE=true

DB_HOST_REPORTAL=127.0.0.1
DB_PORT_REPORTAL=1433
DB_DATABASE_REPORTAL=RE_PORTALDB
DB_USERNAME_REPORTAL=smart_user
DB_PASSWORD_REPORTAL=
DB_REPORTAL_TRUST_SERVER_CERTIFICATE=true

# Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# ==========================================
# [PHASE 2 - BACKGROUND QUEUE CONNECTION]
# In Phase 1, queue worker container is disabled; use QUEUE_CONNECTION=sync
# When transitioning to Phase 2, switch to QUEUE_CONNECTION=database
# ==========================================
QUEUE_CONNECTION=sync
# QUEUE_CONNECTION=database
# ==========================================

# Broadcast & Cache Configuration
BROADCAST_CONNECTION=mercure
CACHE_STORE=database
FILESYSTEM_DISK=local

# Mail Configuration (SMTP)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Mercure Real-time Hub
# MERCURE_URL is the internal dispatch endpoint used by Laravel backend (port 8000 in production, port 80 in dev)
# MERCURE_PUBLIC_URL is the external URL connected by client web browsers (proxied through host NGINX)
MERCURE_URL=http://127.0.0.1:8000/.well-known/mercure
MERCURE_PUBLIC_URL=https://smart.example.com/.well-known/mercure
MERCURE_JWT_SECRET=