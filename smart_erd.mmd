---
config:
  look: neo
  theme: redux-color
  fontFamily: '''Recursive Variable'', sans-serif'
  themeVariables:
    fontFamily: '''Recursive Variable'', sans-serif'
  layout: elk
---
erDiagram
    direction BT
    CATEGORY {
        int id PK ""  
        char_4 code UK ""  
        varchar name  ""  
    }

    TYPE {
        int id PK ""  
        char_9 code UK ""  
        varchar name  ""  
        varchar description  "nullable"  
        boolean is_consumable  ""  
        int category_id FK ""  
    }

    UOM {
        int id PK ""  
        varchar name  "satuan barang"  
    }

    BRAND {
        int id PK ""  
        varchar name  ""  
        varchar description  "nullable"  
    }

    VENDOR {
        int id PK ""  
        char_7 code UK ""  
        varchar name  ""  
        varchar address  "nullable"  
        varchar phone_number  "nullable"  
        varchar email  "nullable"  
        varchar description  "nullable"  
    }

    VENDORS_CP {
        int id PK ""  
        int vendor_id FK ""  
        varchar contact_person  "nullable"  
        varchar cp_email  "nullable"  
        varchar cp_phone  "nullable"  
    }

    ORGANIZER {
        int id PK ""  
        varchar name  ""  
    }

    LOCATION {
        int id PK ""  
        varchar name  ""  
        int parent_id FK "nullable | self-referential indirection"  
        int related_departement FK "nullable | USER_HRIS_HRD_ORGCHART's id"  
        boolean is_active  "default to true"  
    }

    USER_HRIS_HRD_EMPLOYEE {
        int id PK ""  
        int orgchart_id FK "nullable"  
        varchar employee_id UK ""  
        varchar employee_name  ""  
        varchar email UK ""  
        boolean active  "default to true"  
    }

    ADM_USER_NEW_PORTAL_USERS {
        int id PK ""  
        varchar employee_id FK "USER_HRIS_HRD_EMPLOYEE's employee_id"  
        varchar password_hash  ""  
        varchar name  ""  
        varchar remember_token  "nullable"  
    }

    USER_HRIS_HRD_ORGCHART {
        int id PK ""  
        varchar employee_id FK "nullable | USER_HRIS_HRD_EMPLOYEE's employee_id"  
        varchar org_code UK ""  
        varchar org_name UK ""  
    }

    RE_PORTALDB_TB_PROJECT {
        int id PK ""  
        varchar no_project UK ""  
        varchar project_name  ""  
        varchar client_id  ""  
    }

    RE_PORTALDB_TB_ASSIGN_PROJECT  {
        int id PK ""  
        varchar npk FK "ADM_USER_NEW_PORTAL_USERS's employee_id"  
        varchar no_project FK "RE_PORTALDB_TB_PROJECT's no_project"  
        varchar id_rbs FK "RE_PORTALDB_TB_RBS's id"  
        datetime start_date  ""  
        datetime end_date  "nullable"  
    }

    RE_PORTALDB_TB_RBS {
        int no_urut PK ""  
        varchar id UK ""  
        varchar name  ""  
        varchar showing_name  ""  
    }

    ROLE {
        int id PK ""  
        varchar_50 name UK ""  
        varchar_100 label  ""  
        text description  "nullable"  
    }

    PERMISSION {
        int id PK ""  
        varchar_100 name UK ""  
        varchar_150 label  ""  
        varchar_50 group  "index"  
        text description  "nullable"  
    }

    ROLE_PERMISSION {
        int id PK ""  
        int role_id FK ""  
        int permission_id FK ""  
    }

    USER_ROLE {
        int id PK ""  
        int user_id FK "USER_HRIS_HRD_EMPLOYEE's id"  
        int role_id FK ""  
    }

    MODEL {
        int id PK ""  
        varchar_50 number UK ""  
        int type_id FK ""  
        int brand_id FK ""  
        int uom_id FK ""  
        varchar name  ""  
        varchar specification  "nullable"  
        int min_stock_threshold  "nullable | default to 0"  
        datetime last_restock_at  "nullable"  
    }

    LOT {
        int id PK ""  
        varchar_50 number UK ""  
        int model_id FK ""  
        int organizer_id FK ""  
        int vendor_id FK "nullable | Refers to eproc:vendors.id"  
        int legacy_vendor_id FK "nullable | Refers to vendors.id"  
        int initial_quantity  "nullable in db | for consumables"  
        int current_quantity  "nullable | for consumables"  
        varchar_50 entry_type  "default to Procurement"  
        varchar po_number  "nullable"  
        datetime purchase_grant_date  ""  
        varchar memo_number  "nullable"  
        varchar memo_url  "nullable"  
        int location_id FK "nullable | for consumables"  
        numeric unit_price  "nullable | for consumables"  
        varchar image_url  "nullable | for consumables"  
        varchar burden  "nullable | for consumables"  
        int project_id FK "nullable | for consumables, RE_PORTALDB_TB_PROJECT's id"  
    }

    ASSET {
        int id PK ""  
        varchar_50 number UK ""  
        varchar_50 legacy_number  "nullable | legacy asset code/number"  
        int lot_id FK ""  
        int legacy_vendor_id FK "nullable | Refers to vendors.id (legacy migration only)"  
        int location_id FK "nullable | current location"  
        varchar status  "default to Belum Diverifikasi"  
        varchar condition  ""  
        varchar comp_specification  "nullable | specification for computer category"  
        varchar_2 borrowing_type  "LT | ST"  
        varchar_255 classification  "Aset | Inventaris"  
        numeric price  "nullable"  
        varchar image_url  "nullable"  
        varchar vehicle_registration  "nullable"  
        varchar_20 burden  "nullable | Corporate | Project"  
        int project_id FK "nullable | RE_PORTALDB_TB_PROJECT's id"  
    }

    ASSET_STATUS_APPROVAL {
        int id PK ""  
        int asset_id FK ""  
        int requester_id FK "ADM_USER_NEW_PORTAL_USERS's id"  
        int approver_id FK "nullable | ADM_USER_NEW_PORTAL_USERS's id"  
        varchar proposed_condition  ""  
        varchar previous_condition  ""  
        varchar previous_status  "nullable"  
        varchar memo_url  ""  
        varchar lost_doc_url  "nullable"  
        varchar bod_boc_approval_url  "nullable"  
        varchar decision  "default to pending | pending, approved, rejected"  
        text note  "nullable | required if rejected"  
        datetime requested_at  ""  
        datetime decided_at  "nullable"  
    }

    ASSET_ACTIVATION_APPROVAL {
        int id PK ""  
        int asset_id FK ""  
        int requester_id FK "ADM_USER_NEW_PORTAL_USERS's id"  
        int approver_id FK "nullable | ADM_USER_NEW_PORTAL_USERS's id"  
        varchar decision  "default to pending | pending, approved, rejected"  
        text note  "nullable | decision explanation note"  
        datetime requested_at  ""  
        datetime decided_at  "nullable"  
    }

    INVENTORY_LOG {
        int id PK ""  
        int model_id FK "nullable"  
        int lot_id FK "nullable"  
        int asset_id FK "nullable"  
        int user_id FK "ADM_USER_NEW_PORTAL_USERS's id"  
        varchar action_type  "stock_in, stock_out, adjustment, relocation"  
        int quantity_change  "default to 0"  
        json previous_state  "nullable"  
        json new_state  "nullable"  
        text note  "nullable"  
        varchar document_url  "nullable"  
        datetime created_at  ""  
    }

    ASSET_LIFECYCLE {
        int id PK ""  
        int asset_id FK ""  
        varchar action_type  "registrasi, perubahan_status, perubahan_kondisi, pemindahan, peminjaman, pengembalian, pemeliharaan"  
        varchar status  ""  
        varchar condition  ""  
        int location_id FK "nullable"  
        datetime start_date  ""  
        datetime end_date  "nullable"  
        int actor_id FK "nullable | ADM_USER_NEW_PORTAL_USERS's id"  
        text note  "nullable"  
        json previous_state  "nullable"  
        json new_state  "nullable"  
    }

    CONSUMABLE_BASKET {
        int id PK ""  
        int user_id FK "ADM_USER_NEW_PORTAL_USERS's id"  
        int type_id FK "nullable"  
        int model_id FK "nullable"  
        int quantity  ""  
    }

    ASSET_BASKET {
        int id PK ""  
        int user_id FK "ADM_USER_NEW_PORTAL_USERS's id"  
        int type_id FK "nullable"  
        int model_id FK "nullable"  
        int quantity  ""  
        datetime start_date  ""  
        datetime end_date  ""  
    }

    REQUEST {
        int id PK ""  
        uuid uuid UK "nullable"  
        char_11 request_number UK ""  
        int user_id FK "ADM_USER_NEW_PORTAL_USERS's id"  
        int approver_id FK "ADM_USER_NEW_PORTAL_USERS's id"  
        varchar utilization  "nullable in db for data migration | mandatory in-app | project / corporate"  
        int org_id FK "nullable | USER_HRIS_HRD_ORGCHART's id"  
        int project_id FK "nullable | RE_PORTALDB_TB_PROJECT's id"  
        text reasoning  "nullable"  
        varchar status  "wait | approve | confirm | handover | borrow | return | success | reject | cancel | pending"  
    }

    REQUEST_ITEM {
        int id PK ""  
        int request_id FK ""  
        int type_id FK "nullable"  
        int model_id FK "nullable"  
        int quantity_requested  ""  
        datetime start_date  "nullable | assets only"  
        datetime end_date  "nullable | assets only"  
        varchar status  "default to pending"  
    }

    REQUEST_FULFILLMENT {
        int id PK ""  
        int request_item_id FK ""  
        int asset_id FK "nullable | for assets"  
        int lot_id FK "nullable | for consumables"  
        int handover_id FK "nullable | links to schedule"  
        int return_id FK "nullable | links to return schedule"  
        int quantity_fulfilled  "defaults to 1 for assets"  
        datetime assigned_at  "nullable | manual & natural"  
        datetime confirmed_at  "nullable | manual"  
        datetime completed_at  "nullable | manual"  
    }

    REQUEST_APPROVAL {
        int id PK ""  
        int request_id FK ""  
        int approver_id FK "ADM_USER_NEW_PORTAL_USERS's id"  
        varchar decision  "approved | rejected"  
        text note  "nullable | required if rejected"  
        datetime decided_at  ""  
    }

    REQUEST_ADMIN_CONFIRMATION {
        int id PK ""  
        int request_id FK ""  
        int admin_id FK "ADM_USER_NEW_PORTAL_USERS's id"  
        varchar action  "confirm | reject"  
        text note  "nullable"  
        datetime decided_at  ""  
    }

    REQUEST_HANDOVER {
        int id PK ""  
        int request_id FK ""  
        varchar method  "delivery | pickup"  
        datetime scheduled_date  ""  
        varchar location  ""  
        boolean is_auto_set  ""  
        datetime user_confirmed_at  "nullable"  
        boolean auto_confirmed  "default to false"  
        datetime admin_cancelled_at  "nullable"  
        text note  "nullable | required if cancelled"  
    }

    REQUEST_RETURN {
        int id PK ""  
        int request_id FK ""  
        varchar method  "pickup | delivery"  
        datetime scheduled_date  ""  
        varchar location  "default to Ruang IFS"  
        boolean is_auto_set  ""  
        datetime completed_at  "nullable"  
    }

    REQUEST_STATUS_LOG {
        int id PK ""  
        int request_id FK ""  
        varchar status_from  ""  
        varchar status_to  ""  
        int changed_by FK "nullable | ADM_USER_NEW_PORTAL_USERS's id"  
        text note  "nullable"  
        datetime created_at  ""  
    }

    NOTIFICATION {
        uuid id PK ""  
        varchar type ""  
        varchar notifiable_type ""  
        int notifiable_id FK "ADM_USER_NEW_PORTAL_USERS's id"  
        text data ""  
        datetime read_at "nullable"  
        datetime created_at ""  
        datetime updated_at ""  
    }

    SESSION {
        varchar id PK ""  
        int user_id FK "nullable | index"  
        varchar ip_address  "nullable | len: 45"  
        text user_agent  "nullable"  
        text payload  ""  
        int last_activity  "index"  
    }

    CACHE {
        varchar key PK ""  
        mediumtext value  ""  
        int expiration  "index"  
    }

    CACHE_LOCK {
        varchar key PK ""  
        varchar owner  ""  
        int expiration  "index"  
    }

    JOB {
        int id PK ""  
        varchar queue "index"  
        longtext payload ""  
        int attempts ""  
        int reserved_at "nullable"  
        int available_at ""  
        int created_at ""  
    }

    JOB_BATCH {
        varchar id PK ""  
        varchar name ""  
        int total_jobs ""  
        int pending_jobs ""  
        int failed_jobs ""  
        longtext failed_job_ids ""  
        mediumtext options "nullable"  
        int cancelled_at "nullable"  
        int created_at ""  
        int finished_at "nullable"  
    }

    FAILED_JOB {
        int id PK ""  
        varchar uuid UK ""  
        text connection ""  
        text queue ""  
        longtext payload ""  
        longtext exception ""  
        timestamp failed_at ""  
    }

    CATEGORY||--o{TYPE:"has"
    TYPE||--o{MODEL:"classifies"
    UOM||--o{MODEL:"measures"
    BRAND||--o{MODEL:"made by"
    VENDOR||--o{VENDORS_CP:"has contact persons"
    MODEL||--o{LOT:"procured in"
    ORGANIZER||--o{LOT:"managed by"
    VENDOR||--o{LOT:"supplied by (legacy)"
    LOCATION||--o{LOT:"storage location (consumables)"
    LOCATION||--o{LOCATION:"parent to child"
    USER_HRIS_HRD_ORGCHART||--o{LOCATION:"allocated to department"
    LOT||--o{ASSET:"contains"
    VENDOR||--o{ASSET:"supplied by (legacy migration)"
    LOCATION||--o{ASSET:"currently at"
    USER_HRIS_HRD_EMPLOYEE||--||ADM_USER_NEW_PORTAL_USERS:"credentials"
    USER_HRIS_HRD_ORGCHART||--o{USER_HRIS_HRD_EMPLOYEE:"employs"
    USER_HRIS_HRD_EMPLOYEE||--o{USER_HRIS_HRD_ORGCHART:"manages"
    ROLE||--o{ROLE_PERMISSION:"grants"
    PERMISSION||--o{ROLE_PERMISSION:"assigned to"
    ROLE||--o{USER_ROLE:"assigned to"
    USER_HRIS_HRD_EMPLOYEE||--o{USER_ROLE:"holds"
    ADM_USER_NEW_PORTAL_USERS||--o{CONSUMABLE_BASKET:"owns"
    MODEL||--o{CONSUMABLE_BASKET:"in"
    TYPE||--o{CONSUMABLE_BASKET:"in"
    ADM_USER_NEW_PORTAL_USERS||--o{ASSET_BASKET:"owns"
    MODEL||--o{ASSET_BASKET:"in"
    TYPE||--o{ASSET_BASKET:"in"
    ADM_USER_NEW_PORTAL_USERS||--o{RE_PORTALDB_TB_ASSIGN_PROJECT :"assigned to"
    RE_PORTALDB_TB_PROJECT||--o{RE_PORTALDB_TB_ASSIGN_PROJECT :"project details"
    RE_PORTALDB_TB_RBS||--o{RE_PORTALDB_TB_ASSIGN_PROJECT :"assigned as"
    ADM_USER_NEW_PORTAL_USERS||--o{REQUEST:"submits"
    ADM_USER_NEW_PORTAL_USERS||--o{REQUEST:"assigned to approve"
    RE_PORTALDB_TB_PROJECT||--o{REQUEST:"allocated to project"
    USER_HRIS_HRD_ORGCHART||--o{REQUEST:"allocated to dept"
    REQUEST||--o{REQUEST_ITEM:"contains"
    MODEL||--o{REQUEST_ITEM:"requested as"
    TYPE||--o{REQUEST_ITEM:"requested type"
    REQUEST_ITEM||--o{REQUEST_FULFILLMENT:"fulfilled by"
    ASSET||--o{REQUEST_FULFILLMENT:"assigned in"
    LOT||--o{REQUEST_FULFILLMENT:"deducted from"
    REQUEST||--o{REQUEST_HANDOVER:"generates handovers"
    REQUEST_HANDOVER||--o{REQUEST_FULFILLMENT:"delivers"
    REQUEST||--o{REQUEST_RETURN:"generates returns"
    REQUEST_RETURN||--o{REQUEST_FULFILLMENT:"receives"
    REQUEST||--o|REQUEST_APPROVAL:"reviewed by manager"
    ADM_USER_NEW_PORTAL_USERS||--o{REQUEST_APPROVAL:"decides"
    REQUEST||--o|REQUEST_ADMIN_CONFIRMATION:"reviewed by admin"
    ADM_USER_NEW_PORTAL_USERS||--o{REQUEST_ADMIN_CONFIRMATION:"acts on"
    REQUEST||--o{REQUEST_STATUS_LOG:"transitions"
    ADM_USER_NEW_PORTAL_USERS||--o{REQUEST_STATUS_LOG:"actored"
    MODEL||--o{INVENTORY_LOG:"logged"
    LOT||--o{INVENTORY_LOG:"logged"
    ASSET||--o{INVENTORY_LOG:"logged"
    ASSET||--o{ASSET_LIFECYCLE:"tracks lifecycle of"
    LOCATION||--o{ASSET_LIFECYCLE:"location during lifecycle"
    ADM_USER_NEW_PORTAL_USERS||--o{ASSET_LIFECYCLE:"actor"
    ASSET||--o{ASSET_STATUS_APPROVAL:"has pending status changes"
    ADM_USER_NEW_PORTAL_USERS||--o{ASSET_STATUS_APPROVAL:"requests status change"
    ADM_USER_NEW_PORTAL_USERS||--o{ASSET_STATUS_APPROVAL:"decides status change"
    ASSET||--o{ASSET_ACTIVATION_APPROVAL:"has activation approvals"
    ADM_USER_NEW_PORTAL_USERS||--o{ASSET_ACTIVATION_APPROVAL:"requests activation"
    ADM_USER_NEW_PORTAL_USERS||--o{ASSET_ACTIVATION_APPROVAL:"decides activation"
    ADM_USER_NEW_PORTAL_USERS||--o{INVENTORY_LOG:"actored"
    ADM_USER_NEW_PORTAL_USERS||--o{NOTIFICATION:"notified"
    RE_PORTALDB_TB_PROJECT||--o{LOT:"associated with project"
    RE_PORTALDB_TB_PROJECT||--o{ASSET:"associated with project (legacy migration)"
    ADM_USER_NEW_PORTAL_USERS||--o|SESSION:"session owner"
